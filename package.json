{
  "name": "audit-return-active",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests vite.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src tests vite.config.ts package.json tsconfig.json",
    "local": "pa app run --non-interactive",
    "build:pages": "node scripts/browser.mjs build",
    "dev:browser": "node scripts/browser.mjs dev"
  },
  "dependencies": {
    "@microsoft/power-apps": "^1.2.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@azure/msal-browser": "^5.25.1"
  },
  "devDependencies": {
    "@microsoft/power-apps-cli": "1.2.0",
    "@microsoft/power-apps-vite": "^1.0.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
